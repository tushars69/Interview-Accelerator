# Copy this file to backend/.env and fill in your key.
# Get a free Groq API key at: https://console.groq.com/keys
# One key powers all three capabilities: chat/reasoning, speech-to-text, and text-to-speech.
GROQ_API_KEY=your_groq_api_key_here

# --- Model selection (defaults shown; override only if you want to experiment) ---
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI

# --- App ---
APP_ENV=development
DATABASE_URL=sqlite:///./interview_accelerator.db
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Interview tuning ---
MAX_QUESTIONS_PER_LEVEL=5
MIN_QUESTIONS_PER_LEVEL=3
